# Application
ENV=development
PORT=8000
DEBUG=true
SECRET_KEY="replace-with-a-long-random-secret"

# Database
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./tournaments.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional development seed accounts
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# AI / Ollama Cloud OpenAI-compatible API
AI_API_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:120b
AI_CHATBOT_OLLAMA_TIMEOUT_SECONDS=45
AI_CHATBOT_OCR_MODEL=gemma4:31b-cloud
API_KEY=

# Razorpay - required for paid tournament entry
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OAuth - required for Google/Facebook social login
PUBLIC_API_BASE_URL=http://localhost:8000
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Discord - required for organizer announcements
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Streaming - optional; set provider to twitch or youtube
STREAM_PROVIDER=
STREAM_CHANNEL=
STREAM_PARENT_DOMAIN=localhost

# Password reset / email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Tournaments
