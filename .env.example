# Application
ENV=development
PORT=8000
DEBUG=true
SECRET_KEY="replace-with-a-long-random-secret"

# Database
SQLALCHEMY_DATABASE_URI=sqlite+aiosqlite:///./tournaments.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional development seed accounts
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# AI / Ollama
AI_CHATBOT_OLLAMA_BASE_URL=http://localhost:11434
AI_CHATBOT_OLLAMA_MODEL=deepseek-v3.1:671b-cloud
AI_CHATBOT_OLLAMA_TIMEOUT_SECONDS=45
AI_CHATBOT_OCR_MODEL=gemma4:31b-cloud

# Razorpay - required only for paid tournament entry
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=Tournaments
